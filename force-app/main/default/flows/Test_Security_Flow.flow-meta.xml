<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Deployable API 68 screen flow that invokes an existing autolaunched subflow.</description>
    <environments>Default</environments>
    <interviewLabel>Test Security Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test Security Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <runInMode>UserMode</runInMode>
    <screens>
        <name>Collect_Input</name>
        <label>Collect Input</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Invoke_Subflow</targetReference>
        </connector>
        <fields>
            <name>Diagnostic_Input</name>
            <dataType>String</dataType>
            <fieldText>Diagnostic Input</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Display_Output</name>
        <label>Display Output</label>
        <locationX>176</locationX>
        <locationY>402</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Subflow_Output</name>
            <fieldText>&lt;p&gt;Subflow output: {!Invoke_Subflow.outputMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Collect_Input</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Invoke_Subflow</name>
        <label>Invoke API 68 Subflow</label>
        <locationX>176</locationX>
        <locationY>268</locationY>
        <connector>
            <targetReference>Display_Output</targetReference>
        </connector>
        <flowName>API68_User_Mode_Subflow</flowName>
        <inputAssignments>
            <name>inputMessage</name>
            <value>
                <elementReference>Diagnostic_Input</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
</Flow>
